<fw:AcrylicWindow x:Class="aoligei.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpfAnimatedGif="http://wpfanimatedgif.codeplex.com"
        xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
        xmlns:local="clr-namespace:aoligei"
        Topmost="True"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Title="奥力给" Height="390" Width="320"
        fw:AcrylicWindow.Enabled="True"
        fw:AcrylicWindow.AcrylicWindowStyle="Normal"
        NoiseOpacity="0">
    <Grid Margin="12,8,12,12">
        <Grid.RowDefinitions>
            <!-- 外观主题选择 -->
            <RowDefinition Height="Auto"/>

            <!-- 用户选择背景音乐文件夹 -->
            <RowDefinition Height="Auto"/>
            
            <!-- 时间设置 -->
            <RowDefinition Height="Auto"/>
            
            <!-- 开始/重置按钮 -->
            <RowDefinition Height="Auto"/>

            <!-- 音乐设置 -->
            <RowDefinition Height="Auto"/>

            <!-- 当前时间显示 -->
            <RowDefinition Height="Auto"/>

            <!-- 倒计时显示 -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- 外观主题选择 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemBaseHighColorBrush}">
                外观模式：
            </TextBlock>
            <ComboBox x:Name="ThemeComboBox" Width="110" HorizontalAlignment="Right" 
                      Style="{StaticResource ComboBoxRevealStyle}"
                      SelectionChanged="ThemeComboBox_SelectionChanged">
                <ComboBoxItem Content="💻 跟随系统" IsSelected="True"/>
                <ComboBoxItem Content="☀️ 浅色模式"/>
                <ComboBoxItem Content="🌙 深色模式"/>
            </ComboBox>
        </DockPanel>

        <!-- 用户选择背景音乐文件夹 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemBaseHighColorBrush}">背景音乐文件夹：</TextBlock>
            <TextBox x:Name="BackgroundDirBox" Width="105" Margin="5,0" IsReadOnly="True" Style="{StaticResource TextBoxRevealStyle}"/>
            <Button Content="浏览..." Click="BrowseBackgroundFolder_Click" Style="{StaticResource ButtonRevealStyle}" Padding="6,2"/>
        </StackPanel>

        <!-- 时间设置 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemBaseHighColorBrush}">专注分钟数：</TextBlock>
            <TextBox x:Name="MinutesBox" Width="55" Text="30" Margin="10,0" Style="{StaticResource TextBoxRevealStyle}" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <!-- 开始/重置按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="StartButton" Width="135" Content="开始专注" Click="StartButton_Click" 
                    Style="{StaticResource ButtonAccentRevealStyle}" FontWeight="Bold"/>
            <Button x:Name="ResetButton" Width="135" Content="重置" Margin="10,0,0,0" Click="ResetButton_Click" 
                    Style="{StaticResource ButtonRevealStyle}"/>
        </StackPanel>

         <!-- 音乐设置 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="NextTrackButton" Width="135" Content="这个背景音乐不好听" Click="NextTrackButton_Click" 
                    Style="{StaticResource ButtonRevealStyle}" FontSize="12"/>
            <Slider x:Name="VolumeSlider" Width="135" Minimum="0" Maximum="1" Value="0.5" Margin="10,0,0,0" 
                    VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
        </StackPanel>

        <!-- 当前时间显示 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
            <Image x:Name="GifImage1" Width="50" Height="50" Margin="0,0,10,0"/>
            <TextBlock x:Name="TimeTextBlock"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource SystemBaseHighColorBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
            <Image x:Name="GifImage2" Width="50" Height="50" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- 倒计时显示 -->
        <TextBlock x:Name="TimerDisplay" Grid.Row="6" FontSize="46" FontWeight="Bold" 
                   Foreground="{DynamicResource SystemBaseHighColorBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

</fw:AcrylicWindow>
