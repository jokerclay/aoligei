<Window x:Class="aoligei.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpfAnimatedGif="http://wpfanimatedgif.codeplex.com"
        xmlns:local="clr-namespace:aoligei"
        Topmost="True"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Title="奥力给 - 专注悬浮球" Height="370" Width="370">

    <Window.Resources>
        <!-- 默认主题画刷 (由 C# 动态同步切换) -->
        <SolidColorBrush x:Key="CircleBgBrush" Color="#F218181A"/>
        <SolidColorBrush x:Key="CircleBorderBrush" Color="#35FFFFFF"/>
        <SolidColorBrush x:Key="BarBgBrush" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0A5"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF9500"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBgBrush" Color="#2A2A2E"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3A3A40"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#28FFFFFF"/>

        <!-- 胶囊圆角按钮样式 -->
        <Style x:Key="CapsuleButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主强调色胶囊按钮样式 -->
        <Style x:Key="AccentCapsuleButtonStyle" TargetType="Button" BasedOn="{StaticResource CapsuleButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部胶囊图标按钮通用样式 -->
        <Style x:Key="TopIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="bg" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮专用悬浮高亮 (优雅红) -->
        <Style x:Key="CloseIconButtonStyle" TargetType="Button" BasedOn="{StaticResource TopIconButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFF5F56"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 主圆形容器（支持按住任意空白处拖拽窗口） -->
        <Border x:Name="CircleBorder"
                Width="350" Height="350"
                CornerRadius="175"
                Background="{DynamicResource CircleBgBrush}"
                BorderBrush="{DynamicResource CircleBorderBrush}"
                BorderThickness="1.5"
                MouseLeftButtonDown="CircleBorder_MouseLeftButtonDown">
            <Border.Effect>
                <!-- 拟物立体阴影 -->
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270"
                                  Color="#000000" Opacity="0.48"/>
            </Border.Effect>

            <!-- 内部内容容器：完全内敛于圆弧内部 -->
            <Grid Margin="20,18,20,18">
                <Grid.RowDefinitions>
                    <!-- 0: 顶部微型灵动胶囊工具条 -->
                    <RowDefinition Height="36"/>
                    <!-- 1: 当前系统时钟与跑步动图 -->
                    <RowDefinition Height="44"/>
                    <!-- 2: 核心倒计时与时长设定 -->
                    <RowDefinition Height="92"/>
                    <!-- 3: 专注与重置按钮 -->
                    <RowDefinition Height="44"/>
                    <!-- 4: 音乐与音量底栏 -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 0: 顶部内敛灵动胶囊条 (集中放置在圆内最高处，宽度仅165px，100%在圆内) -->
                <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource BarBgBrush}"
                        CornerRadius="13" Padding="8,2"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 主题切换 -->
                        <Button x:Name="ThemeButton" Style="{StaticResource TopIconButtonStyle}" 
                                Width="24" Height="22" Content="🌙"
                                ToolTip="外观主题 (深色 / 浅色 / 跟随系统)"
                                Click="ThemeButton_Click"/>

                        <!-- 居中标题与分割 -->
                        <TextBlock Text="奥力给" 
                                   VerticalAlignment="Center" Margin="10,0"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <!-- 最小化 -->
                        <Button x:Name="MinimizeButton" Style="{StaticResource TopIconButtonStyle}" 
                                Width="22" Height="22" Content="—" ToolTip="最小化"
                                Click="MinimizeButton_Click"/>

                        <!-- 关闭 -->
                        <Button x:Name="CloseButton" Style="{StaticResource CloseIconButtonStyle}" 
                                Width="22" Height="22" Content="✕" ToolTip="关闭窗口"
                                Click="CloseButton_Click" Margin="2,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 1: 当前系统时间与动图 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="GifImage1" Width="36" Height="36" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimeTextBlock"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Image x:Name="GifImage2" Width="36" Height="36" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 2: 核心倒计时与分钟设置 -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 巨大醒目的倒计时数字 -->
                    <TextBlock x:Name="TimerDisplay" 
                               Text="00:00"
                               FontSize="48" 
                               FontWeight="Bold"
                               FontFamily="Segoe UI Variable Display, Consolas, Segoe UI"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" 
                               Margin="0,-4,0,0"/>

                    <!-- 分钟数调节 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock Text="专注时长:" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,6,0"/>
                        <Border Background="{DynamicResource ButtonBgBrush}" 
                                BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="6,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="MinutesBox" Width="32" Text="30" 
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontWeight="SemiBold" FontSize="12"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                <TextBlock Text="分" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- 3: 专注/重置按钮区 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Width="105" Height="32" Content="开始专注 🚀" 
                            Style="{StaticResource AccentCapsuleButtonStyle}" 
                            Click="StartButton_Click"/>
                    <Button x:Name="ResetButton" Width="72" Height="32" Content="重置" 
                            Margin="10,0,0,0"
                            Style="{StaticResource CapsuleButtonStyle}" 
                            Click="ResetButton_Click"/>
                </StackPanel>

                <!-- 4: 音乐与音量底栏 -->
                <StackPanel Grid.Row="4" VerticalAlignment="Center" Margin="10,0,10,2">
                    <!-- 音乐控制按钮行 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <TextBox x:Name="BackgroundDirBox" Visibility="Collapsed"/>
                        
                        <Button x:Name="BrowseFolderButton" Content="📁 选歌" 
                                Width="68" Height="25"
                                Style="{StaticResource CapsuleButtonStyle}"
                                ToolTip="选择背景音乐文件夹"
                                Click="BrowseBackgroundFolder_Click"/>
                        
                        <Button x:Name="NextTrackButton" Content="⏭️ 切歌" 
                                Width="68" Height="25" Margin="8,0,0,0"
                                Style="{StaticResource CapsuleButtonStyle}"
                                ToolTip="播放下一首背景音乐"
                                Click="NextTrackButton_Click"/>
                    </StackPanel>

                    <!-- 音量控制滑块行 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🔈" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="1" Value="0.5" 
                                VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                        <TextBlock Text="🔊" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
